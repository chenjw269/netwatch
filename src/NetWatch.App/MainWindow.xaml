<Window
    x:Class="NetWatch.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetWatch">
    <Grid x:Name="Root" Background="Transparent" SizeChanged="RootSized">
    <Border x:Name="Shell" Background="#FF242b3a" BorderThickness="0" CornerRadius="16" Padding="16,12">
        <Grid>
            <StackPanel x:Name="MiniBar" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="RestoreButton" Style="{StaticResource Pill}" Content="还原" Padding="16,6" HorizontalAlignment="Left" Click="ToggleMini" />
                <Canvas Width="22" Height="22" VerticalAlignment="Center">
                    <Ellipse x:Name="MiniHalo" Canvas.Left="1" Canvas.Top="1" Width="20" Height="20" Opacity="0.4" />
                    <Ellipse x:Name="MiniRing" Canvas.Left="5" Canvas.Top="5" Width="12" Height="12" StrokeThickness="2" />
                    <Ellipse x:Name="MiniCore" Canvas.Left="8" Canvas.Top="8" Width="6" Height="6" />
                </Canvas>
                <TextBlock x:Name="MiniTitle" FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                <Border x:Name="MiniChip" CornerRadius="14" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock x:Name="MiniLatency" FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <StackPanel x:Name="Full" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6" VerticalAlignment="Top">
                        <Button x:Name="DockButton" Style="{StaticResource Pill}" Content="小窗显示" MinWidth="108" Click="ToggleMini" />
                        <Button x:Name="ExpandButton" Style="{StaticResource Pill}" Content="展开详情" MinWidth="108" Click="ToggleExpand" />
                    </StackPanel>
                    <StackPanel x:Name="TextCol" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Canvas Width="22" Height="22" VerticalAlignment="Center">
                                <Ellipse x:Name="DotHalo" Canvas.Left="1" Canvas.Top="1" Width="20" Height="20" Opacity="0.4" />
                                <Ellipse x:Name="DotRing" Canvas.Left="5" Canvas.Top="5" Width="12" Height="12" StrokeThickness="2" />
                                <Ellipse x:Name="DotCore" Canvas.Left="8" Canvas.Top="8" Width="6" Height="6" />
                            </Canvas>
                            <TextBlock x:Name="TitleText" FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Text="正在检测" />
                            <Border x:Name="LatencyChip" CornerRadius="14" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock x:Name="LatencyText" FontFamily="Microsoft YaHei UI" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="…" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SubText" Margin="0,6,0,0" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#8e96a8" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>

                <Border x:Name="DetailHost" Visibility="Collapsed" Background="#f5f7fb" CornerRadius="18" Margin="0,12,0,0" Padding="18,16,12,12" MaxHeight="520">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DetailStack" Spacing="16">
                            <Border Background="White" BorderBrush="#d5dced" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Border Background="#e8edf6">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Background="#8b9bff" />
                                            <TextBlock Text="诊断结果" Margin="10,8" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" Foreground="#1b2330" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="10,8,10,10" Spacing="4">
                                        <TextBlock x:Name="RuleText" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#5e6878" TextWrapping="Wrap" />
                                        <TextBox x:Name="DetailBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#1b2330" Padding="0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="#d5dced" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Border Background="#e8edf6">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Background="#3dbe86" />
                                            <TextBlock Text="链路测试" Margin="10,8" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" Foreground="#1b2330" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="10,8,10,10" Spacing="8">
                                        <Border Background="#f3f6fb" CornerRadius="8" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock x:Name="GatewayTitle" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" Foreground="#1b2330" />
                                                <TextBlock x:Name="GatewayStat" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#5e6878" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#f3f6fb" CornerRadius="8" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock x:Name="InternetTitle" Text="路由器 → 互联网    223.5.5.5" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" Foreground="#1b2330" />
                                                <TextBlock x:Name="InternetStat" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#5e6878" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="柱子的高度代表时延，红色代表该轮连接测试超时。" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#5e6878" TextWrapping="Wrap" />
                                        <StackPanel x:Name="HistoryBars" Orientation="Horizontal" Height="42" Spacing="3" />
                                        <TextBlock x:Name="DeepText" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#5e6878" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="#d5dced" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Border Background="#e8edf6">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Background="#5b8def" />
                                            <TextBlock Text="Wifi 信息" Margin="10,8" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" Foreground="#1b2330" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="10,8,10,10" Spacing="2">
                                        <TextBlock x:Name="WifiTitle" FontFamily="Microsoft YaHei UI" FontSize="14" FontWeight="Bold" Foreground="#1b2330" TextWrapping="Wrap" />
                                        <TextBlock x:Name="WifiSub" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#5e6878" TextWrapping="Wrap" />
                                        <TextBlock x:Name="WifiHint" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#5e6878" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="#d5dced" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <Border Background="#e8edf6">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="4" Background="#e0a84a" />
                                            <TextBlock Text="连接测试" Margin="10,8" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="Bold" Foreground="#1b2330" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Margin="10,8,10,10" Spacing="6">
                                        <TextBlock x:Name="ProxyText" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#5e6878" TextWrapping="Wrap" />
                                        <StackPanel x:Name="SiteList" Spacing="4" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <StackPanel x:Name="Actions" Visibility="Collapsed" Margin="0,12,0,0" Spacing="8">
                    <Border Height="1" Background="#4a5670" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="监测间隔" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#8e96a8" />
                        <Button x:Name="Interval60" Style="{StaticResource Pill}" Content="1 分钟" Padding="12,6" HorizontalAlignment="Left" Click="SetInterval60" />
                        <Button x:Name="Interval180" Style="{StaticResource Pill}" Content="3 分钟" Padding="12,6" HorizontalAlignment="Left" Click="SetInterval180" />
                        <Button x:Name="Interval300" Style="{StaticResource Pill}" Content="5 分钟" Padding="12,6" HorizontalAlignment="Left" Click="SetInterval300" />
                        <Button x:Name="Interval600" Style="{StaticResource Pill}" Content="10 分钟" Padding="12,6" HorizontalAlignment="Left" Click="SetInterval600" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AutostartButton" Style="{StaticResource Pill}" HorizontalAlignment="Left" Click="ToggleAutostart" />
                        <Button x:Name="PauseButton" Style="{StaticResource Pill}" HorizontalAlignment="Left" Click="TogglePause" />
                        <Button x:Name="TopmostButton" Style="{StaticResource Pill}" HorizontalAlignment="Left" Click="ToggleTopmost" />
                        <Button Style="{StaticResource Pill}" Content="退出" HorizontalAlignment="Left" Click="ExitApp" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DeepButton" Style="{StaticResource Pill}" Content="丢包率测试" HorizontalAlignment="Left" Click="StartDeep" />
                        <Button Style="{StaticResource Pill}" Content="复制诊断结果" HorizontalAlignment="Left" Click="CopyDiagnosis" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Popup x:Name="CopiedPopup" IsLightDismissEnabled="true">
                <Border Background="#222633" CornerRadius="8" Padding="22,12">
                    <TextBlock Text="已复制" Foreground="#f4f6fb" FontFamily="Microsoft YaHei UI" FontSize="14" />
                </Border>
            </Popup>
        </Grid>
    </Border>
    </Grid>
</Window>
